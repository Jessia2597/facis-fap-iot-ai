node_modules/
dist/
.vite/
*.local

# vue-tsc compiled output (must NOT exist — Vite uses these over .ts sources)
src/**/*.js
src/**/*.d.ts
!src/env.d.ts

# Vite resolves vite.config.js in preference to vite.config.ts. A stale .js
# next to the .ts shadows source-of-truth changes silently.
vite.config.js
