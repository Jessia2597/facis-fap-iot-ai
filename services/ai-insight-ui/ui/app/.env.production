# Production environment for the AI Insight UI, served by UIBUILDER at
# https://fap-iotai.facis.cloud/orce/aiInsight/.
#
# After the Phase 3 pure-UIBUILDER conversion, the 6 Phase-5 features
# (alerts, data-sources, provenance, integrations, schemas, admin) and the
# AI Assistant request/response no longer use HTTP — they flow over the
# UIBUILDER socket per FAP §9. The two VITE_*_API_URL values below are
# retained as fallbacks for the simulation snapshot endpoints (meters, PV,
# weather, prices, loads) which are still served as REST by the simulation
# tab on the same /api/v1 prefix.
VITE_SIM_API_URL=/api/v1
VITE_AI_API_URL=/api/v1

VITE_KEYCLOAK_URL=https://identity.facis.cloud
VITE_KEYCLOAK_REALM=facis
VITE_KEYCLOAK_CLIENT_ID=facis-ai-insight
