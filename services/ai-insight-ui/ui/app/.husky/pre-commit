#!/usr/bin/env bash
# Run lint-staged from the ui/app workspace if any of its files are staged.
cd "$(git rev-parse --show-toplevel)"
STAGED_UI_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^services/ai-insight-ui/ui/app/' || true)
if [[ -n "$STAGED_UI_FILES" ]]; then
  cd services/ai-insight-ui/ui/app && npx lint-staged
fi
